{
  "name": "qualityforge",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "Evidence-first browser quality automation for modern web applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/quality-context.js": {
      "types": "./dist/fixtures/quality-context.d.ts",
      "default": "./dist/fixtures/quality-context.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qualityforge": "./dist/cli/collect-defects.js",
    "qualityforge-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninelegsdog/qualityforge.git"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "quality",
    "accessibility",
    "observability",
    "mcp"
  ],
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke --project=chromium",
    "test:unit": "playwright test tests/unit",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:clean": "node scripts/clean.mjs",
    "defects:collect": "tsx src/cli/collect-defects.ts",
    "defects:check": "python3 scripts/report-check.py .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:fixtures": "node scripts/serve.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run format:check",
    "prepare": "npm run build",
    "ci:validate": "python3 scripts/validate-ci.py .",
    "docs:check": "python3 scripts/check-links.py .",
    "docs:numbers": "python3 scripts/doc-numbers-check.py .",
    "docs:support": "python3 scripts/client-support-check.py .",
    "board:check": "python3 scripts/board-check.py .",
    "package:check": "python3 scripts/package-check.py .",
    "mcp:check": "python3 scripts/mcp-session-check.py .",
    "mcp:schema": "python3 scripts/capabilities-schema-check.py .",
    "mcp:live": "python3 scripts/mcp-live-check.py .",
    "mcp:check:tools": "python3 scripts/mcp-tools-check.py .",
    "mcp:check:all": "python3 scripts/mcp-check-all.py .",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:check:spawn": "python3 scripts/mcp-spawn-check.py ."
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
