# Base URL of the application under test.
# Default: the bundled zero-dependency fixture server (fixtures/index.html).
# Point it at your own app to run the same suite against a real product.
BASE_URL=http://127.0.0.1:4311

# Credentials for authenticated flows. Never commit real values.
# QUALITYFORGE_USER=
# QUALITYFORGE_PASSWORD=
# QUALITYFORGE_STORAGE_STATE=

# Where QualityForge writes normalized defect artifacts (planned v0.1.0).
# QUALITYFORGE_ARTIFACTS_ROOT=./artifacts

# Verbosity for the test runner.
# PWDEBUG=1
# DEBUG=pw:api,pw:browser