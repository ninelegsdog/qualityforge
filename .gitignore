# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
*.tsbuildinfo

# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Evidence artifacts — the product's output, not source.
#
# The whole tree is ignored, with no .gitkeep. A .gitkeep inside an output
# directory is a liability: it is the first thing a cleanup script removes, and
# then the directory shape silently depends on whatever ran last. Consumers
# create the tree on demand instead.
artifacts/

# Run history is committed on purpose: it is a few hundred bytes per run, it is how
# "is this a regression" gets an answer, and an answer nobody kept is worth less than
# the bytes. Configured via `history.directory`; this covers the default.

# Playwright working directories
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/
playwright-cli/

# Screenshots / videos / traces produced ad hoc.
#

*.png
# **Except** the appearance baselines, which are source and not output. #41 asks
# that a reviewer see an approved appearance in the diff, and an approval nobody can
# see is not an approval — it is a fact buried in one run's artifacts. The collector
# hashes exactly these files, so they and the verdicts that read them cannot drift
# apart the way a manifest beside them could.
#
# Placed *after* `*.png` on purpose: in a gitignore the later rule wins, so a negation
# above the pattern it negates is simply overridden.
!tests/visual-baselines/*.png
*.jpeg
*.jpg
*.webm
*.zip

# Coverage
coverage/
*.lcov

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local caches
.cache/

# Python bytecode from the maintainer scripts (ci:validate, mcp:check)
__pycache__/
*.pyc

# Per-agent worktree scaffolding, never committed
.githooks/
.agent-zone

