{
  "schemaVersion": "1.0.0",
  "name": "qualityforge-demo",
  "baseUrl": "http://127.0.0.1:4311",
  "projects": ["chromium"],
  "evidence": {
    "trace": "on-first-retry",
    "screenshot": "only-on-failure",
    "video": "retain-on-failure"
  },
  "thresholds": {
    "maxFailureRate": 0.05,
    "maxAttemptsPerTest": 2,
    "maxDurationMs": 900000,
    "maxTransferredBytes": 20000
  },
  "defects": {
    "directory": "artifacts/defects",
    "writeSummary": true,
    "referenceErrorContext": true
  },
  "history": {
    "directory": "quality-history",
    "keep": 200
  },
  "api": {
    "expectations": [
      {
        "name": "items-are-json",
        "method": "GET",
        "path": "/api/items",
        "status": 200,
        "contentType": "application/json",
        "responseRequires": ["[0].id", "[0].name"]
      },
      {
        "name": "contact-is-posted-and-accepted",
        "method": "POST",
        "path": "/api/contact",
        "requestRequires": ["email", "message"],
        "status": 200,
        "contentType": "application/json"
      }
    ]
  },
  "tags": ["demo", "smoke"],
  "visual": {
    "project": "chromium",
    "directory": "tests/visual-baselines",
    "pages": ["/", "/docs", "/contact"]
  }
}
